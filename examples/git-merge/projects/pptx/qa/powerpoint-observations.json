        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 43.2,
          "top": 122.4,
          "width": 864.0,
          "height": 53.28,
          "text": "普通 revert 改变当前内容，却不是“今后永远禁止这项修改”的指令。",
