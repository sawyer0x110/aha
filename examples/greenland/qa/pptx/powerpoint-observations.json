          "top": 201.6,
          "width": 208.8,
          "height": 34.56,
          "text": "读数的边界",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 10,
          "name": "Text 7",
          "type": 1,
          "left": 678.24,
          "top": 254.16,
          "width": 208.8,
          "height": 137.52,
          "text": "格陵兰总面积包括冰盖，\r不是只算无冰区。\r\r两地数字并非出自\r统一的测量流程。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 11,
          "name": "Text 8",
          "type": 1,
          "left": 678.24,
          "top": 400.32,
          "width": 208.8,
          "height": 43.92,
          "text": "“约14倍”是面积比，\r不是轮廓装箱结论。",
          "hasTable": false,
          "hasChart": false
        }
      ]
    },
