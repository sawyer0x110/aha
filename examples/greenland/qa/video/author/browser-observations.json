    },
    {
      "id": "local-angles",
      "segmentIndex": 9,
      "progress": 0.5,
      "theme": "light",
      "motion": null,
      "caption": {
        "text": "Mercator is not simply wrong. It preserves local angles, useful for expressing compass headings.",
        "x": 64,
        "y": 593.625,
        "width": 1152,
        "height": 102.375,
        "right": 1216,
        "bottom": 696
      },
      "font": "\"Segoe UI\", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif"
    },
    {
      "id": "constant-heading",
      "segmentIndex": 10,
      "progress": 0.5,
      "theme": "light",
      "motion": null,
      "caption": {
        "text": "A constant-heading route becomes a straight line on Mercator. It is usually not the shortest path across the globe.",
        "x": 64,
        "y": 593.625,
        "width": 1152,
        "height": 102.375,
        "right": 1216,
        "bottom": 696
      },
      "font": "\"Segoe UI\", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif"
    },
    {
      "id": "equal-earth",
      "segmentIndex": 11,
      "progress": 0.5,
      "theme": "light",
      "motion": null,
      "caption": {
        "text": "For comparing areas, choose an equal-area projection such as Equal Earth. Greenland and Africa now have their correct relative areas.",
        "x": 64,
        "y": 593.625,
        "width": 1152,
        "height": 102.375,
        "right": 1216,
        "bottom": 696
      },
      "font": "\"Segoe UI\", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif"
    },
