        },
        {
          "id": 8,
          "name": "Text 6",
          "type": 1,
          "left": 59.76,
          "top": 255.6,
          "width": 150.48,
          "height": 28.08,
          "text": "同一段语音",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 9,
          "name": "Shape 7",
          "type": 9,
          "left": 229.68,
          "top": 216.0,
          "width": 58.32,
          "height": 40.32,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 10,
          "name": "Shape 8",
          "type": 9,
          "left": 229.68,
          "top": 282.96,
          "width": 58.32,
          "height": 46.08,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 11,
          "name": "Shape 9",
          "type": 1,
          "left": 297.36,
          "top": 186.48,
          "width": 289.44,
          "height": 64.08,
