          "width": 864.0,
          "height": 64.8,
          "text": "降噪耳机为什么仍能听见人声？",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 495.36,
          "width": 820.8,
          "height": 25.2,
          "text": "研究快照：2026-09-16 / 17；本作品不冒充新实测",
