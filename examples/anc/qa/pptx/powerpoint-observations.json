          "hasChart": false
        },
        {
          "id": 12,
          "name": "Text 10",
          "type": 1,
          "left": 314.64,
          "top": 202.32,
          "width": 254.88,
          "height": 28.8,
          "text": "部分成分被削弱",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 13,
          "name": "Shape 11",
          "type": 1,
          "left": 297.36,
          "top": 296.64,
          "width": 289.44,
          "height": 64.08,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 14,
          "name": "Text 12",
          "type": 1,
          "left": 314.64,
          "top": 312.48,
          "width": 254.88,
          "height": 28.8,
          "text": "其他成分仍有残余",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 15,
          "name": "Shape 13",
          "type": 9,
          "left": 596.16,
          "top": 329.04,
          "width": 43.92,
          "height": 0.0,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 16,
          "name": "Text 14",
          "type": 1,
          "left": 657.36,
          "top": 280.08,
          "width": 246.24,
          "height": 74.88,
          "text": "残余若仍足够可听，\r就仍能听见人声。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 17,
          "name": "Text 15",
          "type": 1,
          "left": 46.8,
          "top": 400.32,
          "width": 864.0,
          "height": 64.8,
          "text": "反例：耳道封闭时，自己的低频说话声可能增强；主动控制可减轻这种增强。\r这说明语音并非不能抵消，但不等于能完全消除外部说话声。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 18,
          "name": "Text 16",
          "type": 1,
          "left": 46.8,
          "top": 472.32,
          "width": 864.0,
          "height": 19.44,
          "text": "轰鸣减得更多时，人声可能更突出；“更突出”不等于语音声压被放大。",
          "hasTable": false,
          "hasChart": false
        }
      ]
    },
    {
      "slide": 6,
      "image": "slide-06.png",
      "shapes": [
        {
          "id": 2,
          "name": "Text 0",
          "type": 1,
          "left": 46.8,
          "top": 18.0,
          "width": 770.4,
          "height": 18.0,
          "text": "听懂降噪耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 55.44,
          "width": 867.6,
          "height": 46.08,
          "text": "真实佩戴：先分清模式，再解释效果",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 46.8,
          "top": 506.88,
          "width": 828.0,
          "height": 18.0,
          "text": "来源：Apple 聆听模式说明；Sony 使用指南；Hilgemann 等 §2.2、§6.3。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 5,
          "name": "Text 3",
          "type": 1,
          "left": 873.36,
          "top": 505.44,
          "width": 39.6,
          "height": 20.16,
          "text": "06",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 6,
          "name": "Text 4",
          "type": 1,
          "left": 46.8,
          "top": 107.28,
          "width": 866.16,
          "height": 20.88,
          "text": "以下模式以 Apple／Sony 所列设备为例；名称和可用功能因产品而异。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 7,
          "name": "Text 5",
          "type": 1,
          "left": 46.8,
          "top": 136.8,
          "width": 59.04,
          "height": 48.24,
          "text": "01",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 8,
          "name": "Text 6",
          "type": 1,
          "left": 46.8,
          "top": 203.04,
          "width": 255.6,
          "height": 33.84,
          "text": "确认模式",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 9,
          "name": "Text 7",
          "type": 1,
          "left": 46.8,
          "top": 256.32,
          "width": 259.2,
          "height": 119.52,
          "text": "ANC 加入控制声。\r通透模式让外界声音进入。\r自适应模式会随环境调整。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 10,
          "name": "Shape 8",
          "type": 9,
          "left": 133.92,
          "top": 160.56,
          "width": 162.0,
          "height": 0.0,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 11,
          "name": "Text 9",
          "type": 1,
          "left": 344.16,
          "top": 136.8,
          "width": 59.04,
          "height": 48.24,
          "text": "02",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 12,
          "name": "Text 10",
          "type": 1,
          "left": 344.16,
          "top": 203.04,
          "width": 255.6,
          "height": 33.84,
          "text": "留意佩戴",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 13,
          "name": "Text 11",
          "type": 1,
          "left": 344.16,
          "top": 256.32,
          "width": 259.2,
          "height": 119.52,
          "text": "耳形、松紧与泄漏\r都会改变声学路径；\r同一耳机也可能表现不同。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 14,
          "name": "Shape 12",
          "type": 9,
          "left": 431.28,
          "top": 160.56,
          "width": 162.0,
          "height": 0.0,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 15,
          "name": "Text 13",
          "type": 1,
          "left": 641.52,
          "top": 136.8,
          "width": 59.04,
          "height": 48.24,
          "text": "03",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 16,
          "name": "Text 14",
          "type": 1,
          "left": 641.52,
          "top": 203.04,
          "width": 255.6,
          "height": 33.84,
          "text": "保持比较条件",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 17,
          "name": "Text 15",
          "type": 1,
          "left": 641.52,
          "top": 256.32,
          "width": 259.2,
          "height": 119.52,
          "text": "比较 ANC 开关时，\r保持同一声源与佩戴，\r别同时改变环境音模式。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 18,
          "name": "Shape 16",
          "type": 1,
          "left": 46.8,
          "top": 390.96,
          "width": 866.16,
          "height": 90.0,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 19,
          "name": "Text 17",
          "type": 1,
          "left": 63.36,
          "top": 404.64,
          "width": 831.6,
          "height": 27.36,
          "text": "已有测量支持“佩戴会影响结果”，却不能替你预测分贝数。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 20,
          "name": "Text 18",
          "type": 1,
          "left": 63.36,
          "top": 444.96,
          "width": 831.6,
          "height": 20.16,
          "text": "材料只选读了作者既有原型研究的部分章节；不是本轮测试，也不是市售耳机排名。",
          "hasTable": false,
          "hasChart": false
        }
      ]
    },
    {
      "slide": 7,
      "image": "slide-07.png",
      "shapes": [
        {
          "id": 2,
          "name": "Text 0",
          "type": 1,
          "left": 46.8,
          "top": 18.0,
          "width": 770.4,
          "height": 18.0,
          "text": "听懂降噪耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 55.44,
          "width": 867.6,
          "height": 46.08,
          "text": "记住：耳边残余，不是声音类别",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 46.8,
          "top": 506.88,
          "width": 828.0,
          "height": 18.0,
          "text": "事实仅据 2026-09-16 冻结研究材料；本轮未新增检索或声学测试。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 5,
          "name": "Text 3",
          "type": 1,
          "left": 873.36,
          "top": 505.44,
          "width": 39.6,
          "height": 20.16,
          "text": "07",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 6,
          "name": "Shape 4",
          "type": 1,
          "left": 46.8,
          "top": 135.36,
          "width": 93.6,
          "height": 41.76,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 7,
          "name": "Text 5",
          "type": 1,
          "left": 54.0,
          "top": 142.56,
          "width": 79.2,
          "height": 26.64,
          "text": "相加",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 8,
          "name": "Text 6",
          "type": 1,
          "left": 158.4,
          "top": 136.08,
          "width": 751.68,
          "height": 41.04,
          "text": "ANC 让控制声与传入声在耳边叠加，力求留下更小起伏。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 9,
          "name": "Shape 7",
          "type": 1,
          "left": 46.8,
          "top": 200.88,
          "width": 93.6,
          "height": 41.76,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 10,
          "name": "Text 8",
          "type": 1,
          "left": 54.0,
          "top": 208.08,
          "width": 79.2,
          "height": 26.64,
          "text": "路径",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 11,
          "name": "Text 9",
          "type": 1,
          "left": 158.4,
          "top": 201.6,
          "width": 751.68,
          "height": 41.04,
          "text": "控制声需补偿路径造成的幅度、相位变化；被动隔音也参与减噪。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 12,
          "name": "Shape 10",
          "type": 1,
          "left": 46.8,
          "top": 266.4,
          "width": 93.6,
          "height": 41.76,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 13,
          "name": "Text 11",
          "type": 1,
          "left": 54.0,
          "top": 273.6,
          "width": 79.2,
          "height": 26.64,
          "text": "残余",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 14,
          "name": "Text 12",
          "type": 1,
          "left": 158.4,
          "top": 267.12,
          "width": 751.68,
          "height": 41.04,
          "text": "轰鸣可减轻、人声可部分削弱，但残余仍可能足够可听。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 15,
          "name": "Text 13",
          "type": 1,
          "left": 46.8,
          "top": 341.28,
          "width": 864.0,
          "height": 40.32,
          "text": "机制解释不是个人性能预测：本材料不能回答你这次航班各减少了多少分贝。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 16,
          "name": "Text 14",
          "type": 1,
          "left": 46.8,
          "top": 402.48,
          "width": 221.76,
          "height": 24.48,
          "text": "材料来源与边界",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 17,
          "name": "Text 15",
          "type": 1,
          "left": 46.8,
          "top": 439.2,
          "width": 426.96,
          "height": 41.04,
          "text": "RWTH IKS：主动控制原理与自身语音\rSony：WH-1000XM5 使用指南（特定产品）",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 18,
          "name": "Text 16",
          "type": 1,
          "left": 494.64,
          "top": 439.2,
          "width": 416.16,
          "height": 41.04,
          "text": "Hilgemann 等：arXiv:2509.15864v1（选读）\rApple：聆听模式说明（所列设备）",
          "hasTable": false,
          "hasChart": false
        }
      ]
    }
  ],
