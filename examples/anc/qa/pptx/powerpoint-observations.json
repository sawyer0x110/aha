      "shapes": [
        {
          "id": 2,
          "name": "Text 0",
          "type": 1,
          "left": 46.8,
          "top": 18.0,
          "width": 770.4,
          "height": 18.0,
          "text": "听懂降噪耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 506.88,
          "width": 828.0,
          "height": 18.0,
          "text": "来源：Sony WH-1000XM5 使用指南；RWTH IKS「自身语音闭塞效应」。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 873.36,
          "top": 505.44,
          "width": 39.6,
          "height": 20.16,
          "text": "01",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 5,
          "name": "Text 3",
          "type": 1,
          "left": 46.8,
          "top": 72.0,
          "width": 864.0,
          "height": 100.8,
          "text": "降噪耳机：飞机轰鸣变轻了，\r为什么人声还在？",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 6,
          "name": "Text 4",
          "type": 1,
          "left": 46.8,
          "top": 194.4,
          "width": 849.6,
          "height": 67.68,
          "text": "主动降噪不是声音分类器。\r它控制耳边的声压；不同声音成分，留下的残余不同。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 7,
          "name": "Shape 5",
          "type": 1,
          "left": 46.8,
          "top": 296.64,
          "width": 414.0,
          "height": 100.8,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 8,
          "name": "Shape 6",
          "type": 1,
          "left": 482.4,
          "top": 296.64,
          "width": 430.56,
          "height": 100.8,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 9,
          "name": "Text 7",
          "type": 1,
          "left": 64.8,
          "top": 311.04,
          "width": 374.4,
          "height": 25.2,
          "text": "飞机的持续轰鸣",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 10,
          "name": "Text 8",
          "type": 1,
          "left": 64.8,
          "top": 353.52,
          "width": 374.4,
          "height": 24.48,
          "text": "低频成分通常较易控制 → 变轻",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 11,
          "name": "Text 9",
          "type": 1,
          "left": 500.4,
          "top": 311.04,
          "width": 392.4,
          "height": 25.2,
          "text": "附近的人声",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 12,
          "name": "Text 10",
          "type": 1,
          "left": 500.4,
          "top": 353.52,
          "width": 392.4,
          "height": 24.48,
          "text": "部分成分仍然残留 → 仍可听见",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 13,
          "name": "Text 11",
          "type": 1,
          "left": 46.8,
          "top": 432.0,
          "width": 856.8,
          "height": 41.04,
          "text": "仍听得见 ≠ 完全没减弱，也不代表人声天生不能抵消。",
          "hasTable": false,
          "hasChart": false
        }
      ]
    },
    {
      "slide": 2,
      "image": "slide-02.png",
      "shapes": [
        {
          "id": 2,
          "name": "Text 0",
          "type": 1,
          "left": 46.8,
          "top": 18.0,
          "width": 770.4,
          "height": 18.0,
          "text": "听懂降噪耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 55.44,
          "width": 867.6,
          "height": 46.08,
          "text": "抵消发生在耳边，不在声音标签里",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 46.8,
          "top": 506.88,
          "width": 828.0,
          "height": 18.0,
          "text": "来源：RWTH IKS「主动噪声控制」；Hilgemann 等，原作者稿 §2.1–2.2。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 5,
          "name": "Text 3",
          "type": 1,
          "left": 873.36,
          "top": 505.44,
          "width": 39.6,
          "height": 20.16,
          "text": "02",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 6,
          "name": "Text 4",
          "type": 1,
          "left": 46.8,
          "top": 116.64,
          "width": 864.0,
          "height": 39.6,
          "text": "声压就是空气压力的起伏；同一位置、同一时刻的起伏会叠加。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 7,
          "name": "Shape 5",
          "type": 1,
          "left": 54.0,
          "top": 190.8,
          "width": 183.6,
          "height": 62.64,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 8,
          "name": "Text 6",
          "type": 1,
          "left": 68.4,
          "top": 203.76,
          "width": 154.8,
          "height": 30.96,
          "text": "传入噪声",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 9,
          "name": "Text 7",
          "type": 1,
          "left": 260.64,
          "top": 176.4,
          "width": 327.6,
          "height": 25.2,
          "text": "经过耳罩／耳道的路径",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 10,
          "name": "Shape 8",
          "type": 9,
          "left": 244.8,
          "top": 222.48,
          "width": 365.76,
          "height": 0.0,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 11,
          "name": "Shape 9",
          "type": 1,
          "left": 54.0,
          "top": 291.6,
          "width": 183.6,
          "height": 64.8,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 12,
          "name": "Text 10",
          "type": 1,
          "left": 68.4,
          "top": 306.0,
          "width": 154.8,
          "height": 30.96,
          "text": "麦克风信号",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 13,
          "name": "Shape 11",
          "type": 1,
          "left": 288.0,
          "top": 291.6,
          "width": 252.0,
          "height": 64.8,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 14,
          "name": "Text 12",
          "type": 1,
          "left": 303.84,
          "top": 306.0,
          "width": 220.32,
          "height": 30.96,
          "text": "控制器 → 扬声器",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 15,
          "name": "Shape 13",
          "type": 9,
          "left": 243.36,
          "top": 324.0,
          "width": 36.0,
          "height": 0.0,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 16,
          "name": "Text 14",
          "type": 1,
          "left": 241.2,
          "top": 355.68,
          "width": 47.52,
          "height": 21.6,
          "text": "处理",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 17,
          "name": "Shape 15",
          "type": 9,
          "left": 545.76,
          "top": 324.0,
          "width": 77.76,
          "height": 0.0,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 18,
          "name": "Text 16",
          "type": 1,
          "left": 290.16,
          "top": 365.04,
          "width": 345.6,
          "height": 23.04,
          "text": "控制声也经过声学路径",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 19,
          "name": "Shape 17",
          "type": 1,
          "left": 633.6,
          "top": 190.8,
          "width": 271.44,
          "height": 165.6,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 20,
          "name": "Text 18",
          "type": 1,
          "left": 650.88,
          "top": 208.8,
          "width": 236.88,
          "height": 32.4,
          "text": "耳边目标位置",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 21,
          "name": "Text 19",
          "type": 1,
          "left": 650.88,
          "top": 261.36,
          "width": 236.88,
          "height": 65.52,
          "text": "传入声压 ＋ 控制声压\r＝ 剩下的声压起伏",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 22,
          "name": "Text 20",
          "type": 1,
          "left": 46.8,
          "top": 399.6,
          "width": 864.0,
          "height": 56.16,
          "text": "理想单频：在耳边同频、等幅、反相，才可完全抵消。\r“反相”：噪声使压力增加时，控制声恰好使它等量减少。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 23,
          "name": "Text 21",
          "type": 1,
          "left": 46.8,
          "top": 467.28,
          "width": 864.0,
          "height": 25.92,
          "text": "小信号线性近似；麦克风处有效，不代表耳内每一点或整个机舱都安静。",
          "hasTable": false,
          "hasChart": false
        }
      ]
    },
    {
      "slide": 3,
      "image": "slide-03.png",
      "shapes": [
        {
          "id": 2,
          "name": "Text 0",
          "type": 1,
          "left": 46.8,
          "top": 18.0,
          "width": 770.4,
          "height": 18.0,
          "text": "听懂降噪耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 55.44,
          "width": 867.6,
          "height": 46.08,
          "text": "振动越快，同样的时间误差越难容忍",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 46.8,
          "top": 506.88,
          "width": 828.0,
          "height": 18.0,
          "text": "来源：冻结材料中的单频解析推论；RWTH IKS 的路径与延迟讨论。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 5,
          "name": "Text 3",
          "type": 1,
          "left": 873.36,
          "top": 505.44,
          "width": 39.6,
          "height": 20.16,
          "text": "03",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 6,
          "name": "Text 4",
          "type": 1,
          "left": 46.8,
          "top": 117.36,
          "width": 864.0,
          "height": 70.56,
          "text": "相位：一次振动进行到哪里。\r同样晚到一点，在更快的振动中会错开更大一段。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 7,
          "name": "Shape 5",
          "type": 1,
          "left": 46.8,
          "top": 210.96,
          "width": 866.16,
          "height": 43.92,
          "text": null,
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 8,
          "name": "Text 6",
          "type": 1,
          "left": 61.2,
          "top": 221.76,
          "width": 838.8,
          "height": 20.88,
          "text": "教学假设：未补偿的到达时间误差为 0.10 毫秒（不是实测耳机延迟）",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 9,
          "name": "Table 0",
          "type": 19,
          "left": 46.8,
          "top": 269.28,
          "width": 866.16,
          "height": 136.08,
          "text": null,
          "hasTable": true,
          "hasChart": false
        },
        {
          "id": 10,
          "name": "Text 7",
          "type": 1,
          "left": 46.8,
          "top": 427.68,
          "width": 864.0,
          "height": 30.24,
          "text": "等幅还不够：错相会留下残余，严重时甚至可能比原噪声更大。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 11,
          "name": "Text 8",
          "type": 1,
          "left": 46.8,
          "top": 467.28,
          "width": 864.0,
          "height": 21.6,
          "text": "这是同一位置、稳态单频的线性模型；不是声速变快，也没有给 ANC 划定统一截止频率。",
          "hasTable": false,
          "hasChart": false
        }
      ]
    },
    {
      "slide": 4,
      "image": "slide-04.png",
      "shapes": [
        {
          "id": 2,
          "name": "Text 0",
          "type": 1,
          "left": 46.8,
          "top": 18.0,
          "width": 770.4,
          "height": 18.0,
          "text": "听懂降噪耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 55.44,
          "width": 867.6,
          "height": 46.08,
          "text": "耳机有两种减噪方式，不是一个开关",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 46.8,
          "top": 506.88,
          "width": 828.0,
          "height": 18.0,
          "text": "来源：Hilgemann 等，原作者稿 §2.1、§2.3。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 5,
          "name": "Text 3",
          "type": 1,
          "left": 873.36,
          "top": 505.44,
          "width": 39.6,
          "height": 20.16,
          "text": "04",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 6,
          "name": "Text 4",
          "type": 1,
          "left": 46.8,
          "top": 116.64,
          "width": 864.0,
          "height": 57.6,
          "text": "被动隔音改变声音传入的路径；主动降噪再加入控制声。两者共同影响残余。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 7,
          "name": "Table 0",
          "type": 19,
          "left": 46.8,
          "top": 187.2,
          "width": 866.16,
          "height": 234.16,
          "text": null,
          "hasTable": true,
          "hasChart": false
        },
        {
          "id": 8,
          "name": "Text 5",
          "type": 1,
          "left": 46.8,
          "top": 450.0,
          "width": 453.6,
          "height": 37.44,
          "text": "关 ANC ≠ 摘下耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 9,
          "name": "Text 6",
          "type": 1,
          "left": 514.8,
          "top": 444.24,
          "width": 396.0,
          "height": 47.52,
          "text": "“通常”不是硬分界；结构、泄漏和佩戴都会改变结果。",
          "hasTable": false,
          "hasChart": false
        }
      ]
    },
    {
      "slide": 5,
      "image": "slide-05.png",
      "shapes": [
        {
          "id": 2,
          "name": "Text 0",
          "type": 1,
          "left": 46.8,
          "top": 18.0,
          "width": 770.4,
          "height": 18.0,
          "text": "听懂降噪耳机",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 3,
          "name": "Text 1",
          "type": 1,
          "left": 46.8,
          "top": 55.44,
          "width": 867.6,
          "height": 46.08,
          "text": "人声可以变弱，却仍然听得见",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 4,
          "name": "Text 2",
          "type": 1,
          "left": 46.8,
          "top": 506.88,
          "width": 828.0,
          "height": 18.0,
          "text": "来源：Sony WH-1000XM5 使用指南；RWTH IKS「自身语音闭塞效应」。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 5,
          "name": "Text 3",
          "type": 1,
          "left": 873.36,
          "top": 505.44,
          "width": 39.6,
          "height": 20.16,
          "text": "05",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 6,
          "name": "Text 4",
          "type": 1,
          "left": 46.8,
          "top": 115.92,
          "width": 864.0,
          "height": 61.2,
          "text": "一段语音不是一个高频纯音。不同频率成分经过耳机后，削弱程度可能不同。",
          "hasTable": false,
          "hasChart": false
        },
        {
          "id": 7,
          "name": "Shape 5",
          "type": 1,
          "left": 46.8,
          "top": 231.84,
          "width": 176.4,
          "height": 75.6,
