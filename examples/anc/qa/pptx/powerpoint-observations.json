          "name": "Text 3",
          "type": 1,
          "left": 54.0,
          "top": 116.64,
          "width": 849.6,
          "height": 86.4,
          "text": "主动降噪在耳边加入控制声压，抵消部分传入波动。理想的完全抵消才要求目标位置等幅反相；部分减弱不要求幅度完全相等。它不是飞机与人声的分类器。",
          "hasTable": false,
          "hasChart": false
        },
