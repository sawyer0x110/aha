      "motion": null,
      "filename": "03-meridians-globe.png",
      "caption": {
        "text": "On a globe, meridians converge toward the poles. Distances between neighboring lines of longitude get smaller.",
        "x": 64,
        "y": 593.625,
        "width": 1152,
        "height": 102.375,
        "right": 1216,
        "bottom": 696
