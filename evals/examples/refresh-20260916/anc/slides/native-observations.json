          "top": 140.4,
          "width": 550.8,
          "height": 68.4
        },
        {
          "name": "Text 5",
          "type": 1,
          "text": "02",
          "left": 64.8,
          "top": 241.2,
          "width": 64.8,
          "height": 43.2
        },
        {
          "name": "Text 6",
          "type": 1,
          "text": "Fit",
          "left": 147.6,
          "top": 241.2,
          "width": 158.4,
          "height": 43.2
        },
        {
          "name": "Text 7",
          "type": 1,
          "text": "Seal and ear position change the paths\rthe controller must handle.",
          "left": 313.2,
          "top": 241.2,
          "width": 550.8,
          "height": 68.4
        },
        {
          "name": "Text 8",
          "type": 1,
          "text": "03",
          "left": 64.8,
          "top": 342.0,
          "width": 64.8,
          "height": 43.2
        },
        {
          "name": "Text 9",
          "type": 1,
          "text": "Baseline",
          "left": 147.6,
          "top": 342.0,
          "width": 158.4,
          "height": 43.2
        },
        {
          "name": "Text 10",
          "type": 1,
          "text": "Compare ANC on/off without moving the fit.\rRemoving the headset changes two things.",
          "left": 313.2,
          "top": 342.0,
          "width": 550.8,
          "height": 68.4
        },
        {
          "name": "Text 11",
          "type": 1,
          "text": "Apple listening modes · Sony WH-1000XM5 guide · model-specific behavior, not identical settings on every device",
          "left": 46.8,
          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
      "number": 8,
      "shapes": [
        {
          "name": "Text 0",
          "type": 1,
          "text": "A clean diagram is not a measured ear",
          "left": 46.8,
          "top": 36.0,
          "width": 864.0,
          "height": 82.8
        },
        {
          "name": "Text 1",
          "type": 1,
          "text": "08",
          "left": 864.0,
          "top": 498.96,
          "width": 43.2,
          "height": 18.0
        },
        {
          "name": "Text 2",
          "type": 1,
          "text": "IDEAL MODEL",
          "left": 64.8,
          "top": 136.8,
          "width": 352.8,
          "height": 39.6
        },
        {
          "name": "Text 3",
          "type": 1,
          "text": "One sinusoid\rOne target position\rLinear pressure addition",
          "left": 64.8,
          "top": 201.6,
          "width": 338.4,
          "height": 144.0
        },
        {
          "name": "Shape 4",
          "type": 9,
          "text": "",
          "left": 410.4,
          "top": 262.8,
          "width": 104.4,
          "height": 0.0
        },
        {
          "name": "Text 5",
          "type": 1,
          "text": "REAL SYSTEM",
          "left": 543.6,
          "top": 136.8,
          "width": 352.8,
          "height": 39.6
        },
        {
          "name": "Text 6",
          "type": 1,
          "text": "Fit-dependent paths\rFinite control bandwidth\rStability and sensor limits",
          "left": 543.6,
          "top": 201.6,
          "width": 356.4,
          "height": 144.0
        },
        {
          "name": "Text 7",
          "type": 1,
          "text": "Published prototype results vary with wearer and fit.\rThey do not predict decibels or speech understanding on your flight.",
          "left": 64.8,
          "top": 381.6,
          "width": 835.2,
          "height": 64.8
        },
        {
          "name": "Text 8",
          "type": 1,
          "text": "Hilgemann, Chatzimoustafa & Jax · arXiv 2509.15864v1 · selected §§2 and 6.3, not a new test",
          "left": 46.8,
          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
