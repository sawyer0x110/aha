          "top": 309.6,
          "width": 144.0,
          "height": 43.2
        },
        {
          "name": "Shape 9",
          "type": 9,
          "text": "",
          "left": 518.4,
          "top": 252.0,
          "width": 118.8,
          "height": 64.8
        },
        {
          "name": "Shape 10",
          "type": 1,
          "text": "",
          "left": 640.8,
          "top": 172.8,
          "width": 165.6,
          "height": 165.6
        },
        {
          "name": "Text 11",
          "type": 1,
          "text": "Ear\rpressure",
          "left": 656.64,
          "top": 215.28,
          "width": 133.92,
          "height": 72.0
        },
        {
          "name": "Text 12",
          "type": 1,
          "text": "Passive: changes transmission.\rActive: adds pressure after a second path.",
          "left": 57.6,
          "top": 115.2,
          "width": 835.2,
          "height": 43.2
        },
        {
          "name": "Text 13",
          "type": 1,
          "text": "Solid = incoming pressure     Dashed = control path",
          "left": 57.6,
          "top": 428.4,
          "width": 720.0,
          "height": 28.8
        },
        {
          "name": "Text 14",
          "type": 1,
          "text": "Often: passive isolation helps higher bands; active control helps lower bands.",
          "left": 57.6,
          "top": 455.04,
          "width": 828.0,
          "height": 21.6
        },
        {
          "name": "Text 15",
          "type": 1,
          "text": "RWTH IKS: Principle · Hilgemann et al. §2: internal microphone is only an approximation to the eardrum",
          "left": 46.8,
          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
      "number": 3,
      "shapes": [
        {
          "name": "Text 0",
          "type": 1,
          "text": "First: noise alone leaves a residual",
          "left": 46.8,
          "top": 36.0,
          "width": 864.0,
          "height": 82.8
        },
        {
          "name": "Text 1",
          "type": 1,
          "text": "03",
          "left": 864.0,
          "top": 498.96,
          "width": 43.2,
          "height": 18.0
        },
        {
          "name": "Chart 0",
          "type": 3,
          "text": "",
          "left": 61.2,
          "top": 133.2,
          "width": 594.0,
          "height": 262.8
        },
        {
          "name": "Text 2",
          "type": 1,
          "text": "No control\rResidual = incoming",
          "left": 680.4,
          "top": 162.0,
          "width": 226.8,
          "height": 172.8
        },
        {
          "name": "Text 3",
          "type": 1,
          "text": "Normalized pressure · ideal single tone · identical target position",
          "left": 61.2,
          "top": 411.84,
          "width": 849.6,
          "height": 28.8
        },
        {
          "name": "Text 4",
          "type": 1,
          "text": "Advance to add the control pressure at the same coordinates.",
          "left": 61.2,
          "top": 442.8,
          "width": 849.6,
          "height": 28.8
        },
        {
          "name": "Text 5",
          "type": 1,
          "text": "Analytical teaching model, not measured performance · RWTH IKS: phase and path matching",
          "left": 46.8,
          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
      "number": 4,
      "shapes": [
        {
          "name": "Text 0",
          "type": 1,
          "text": "Then: opposite pressure reduces the sum",
          "left": 46.8,
          "top": 36.0,
          "width": 864.0,
          "height": 82.8
        },
        {
          "name": "Text 1",
          "type": 1,
          "text": "04",
          "left": 864.0,
          "top": 498.96,
          "width": 43.2,
          "height": 18.0
        },
        {
          "name": "Chart 0",
          "type": 3,
          "text": "",
          "left": 61.2,
          "top": 133.2,
          "width": 594.0,
          "height": 262.8
        },
        {
          "name": "Text 2",
          "type": 1,
          "text": "Equal amplitude\rOpposite phase\rResidual = zero",
          "left": 680.4,
          "top": 162.0,
          "width": 226.8,
          "height": 172.8
        },
        {
          "name": "Text 3",
          "type": 1,
          "text": "Normalized pressure · ideal single tone · identical target position",
          "left": 61.2,
          "top": 411.84,
          "width": 849.6,
          "height": 28.8
        },
        {
          "name": "Text 4",
          "type": 1,
          "text": "Matching must hold after both acoustic paths reach the ear.",
          "left": 61.2,
          "top": 442.8,
          "width": 849.6,
          "height": 28.8
        },
        {
          "name": "Text 5",
          "type": 1,
          "text": "Analytical teaching model, not measured performance · RWTH IKS: phase and path matching",
          "left": 46.8,
          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
      "number": 5,
      "shapes": [
        {
          "name": "Text 0",
          "type": 1,
          "text": "Change the phase: the residual grows",
          "left": 46.8,
          "top": 36.0,
          "width": 864.0,
          "height": 82.8
        },
        {
          "name": "Text 1",
          "type": 1,
          "text": "05",
          "left": 864.0,
          "top": 498.96,
          "width": 43.2,
          "height": 18.0
        },
        {
          "name": "Chart 0",
          "type": 3,
          "text": "",
          "left": 61.2,
          "top": 133.2,
          "width": 594.0,
          "height": 262.8
        },
        {
          "name": "Text 2",
          "type": 1,
          "text": "Equal amplitude\r60° phase error\rResidual = 1 × incoming",
          "left": 680.4,
          "top": 162.0,
          "width": 226.8,
          "height": 172.8
        },
        {
          "name": "Text 3",
          "type": 1,
          "text": "Normalized pressure · ideal single tone · identical target position",
          "left": 61.2,
          "top": 411.84,
          "width": 849.6,
          "height": 28.8
        },
        {
          "name": "Text 4",
          "type": 1,
          "text": "The same time error takes more phase at a higher frequency.",
          "left": 61.2,
          "top": 442.8,
          "width": 849.6,
          "height": 28.8
        },
        {
          "name": "Text 5",
          "type": 1,
          "text": "Analytical teaching model, not measured performance · RWTH IKS: phase and path matching",
          "left": 46.8,
          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
      "number": 6,
      "shapes": [
        {
          "name": "Text 0",
          "type": 1,
          "text": "Speech is not immune to cancellation",
          "left": 46.8,
          "top": 36.0,
          "width": 864.0,
          "height": 82.8
        },
        {
          "name": "Text 1",
          "type": 1,
          "text": "06",
          "left": 864.0,
          "top": 498.96,
          "width": 43.2,
          "height": 18.0
        },
        {
          "name": "Shape 2",
          "type": 1,
          "text": "",
          "left": 57.6,
          "top": 145.44,
          "width": 399.6,
          "height": 273.6
        },
        {
          "name": "Text 3",
          "type": 1,
          "text": "The tempting shortcut",
          "left": 79.2,
          "top": 167.04,
          "width": 356.4,
          "height": 43.2
        },
        {
          "name": "Text 4",
          "type": 1,
          "text": "“Voices remain,\rso voices cannot\rbe cancelled.”",
          "left": 79.2,
          "top": 234.0,
          "width": 352.8,
          "height": 129.6
        },
        {
          "name": "Text 5",
          "type": 1,
          "text": "The counterexample",
          "left": 504.0,
          "top": 169.2,
          "width": 381.6,
          "height": 43.2
        },
        {
          "name": "Text 6",
          "type": 1,
          "text": "Active control can reduce\rlow-frequency own-voice\rocclusion in a closed ear canal.",
          "left": 504.0,
          "top": 230.4,
          "width": 374.4,
          "height": 115.2
        },
        {
          "name": "Text 7",
          "type": 1,
          "text": "This is not a promise to erase\ranother person’s whole voice.",
          "left": 504.0,
          "top": 363.6,
          "width": 374.4,
          "height": 54.0
        },
        {
          "name": "Text 8",
          "type": 1,
          "text": "RWTH IKS: Applications — Occlusion Effect Reduction",
          "left": 46.8,
          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
      "number": 7,
      "shapes": [
        {
          "name": "Text 0",
          "type": 1,
          "text": "Before blaming the voice, check the conditions",
