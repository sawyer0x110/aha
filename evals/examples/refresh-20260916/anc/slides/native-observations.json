          "top": 482.4,
          "width": 777.6,
          "height": 25.2
        }
      ]
    },
    {
      "number": 2,
      "shapes": [
        {
          "name": "Text 0",
          "type": 1,
          "text": "The ear receives two pressure contributions",
          "left": 46.8,
          "top": 36.0,
          "width": 864.0,
          "height": 82.8
        },
        {
          "name": "Text 1",
          "type": 1,
