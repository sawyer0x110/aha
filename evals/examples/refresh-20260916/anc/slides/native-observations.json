          "top": 248.4,
          "width": 100.8,
          "height": 0.0
        },
        {
          "name": "Text 6",
          "type": 1,
          "text": "What remains?",
          "left": 590.4,
          "top": 363.6,
          "width": 288.0,
          "height": 46.8
        },
        {
          "name": "Text 7",
          "type": 1,
          "text": "Sony WH-1000XM5 guide · useful product observation, not a physical ban on cancelling speech",
